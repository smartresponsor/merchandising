{
  "name": "merchandising/merch",
  "description": "Merchandising process app",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "collectioning/collection": "*@dev",
    "cruding/crud": "*@dev",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "*@dev",
    "objecting/object": "*@dev",
    "tabling/table": "*@dev",
    "viewing/view": "*@dev",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.6",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/serializer": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\Merchandising\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "version": "0.1.0-dev"
}
