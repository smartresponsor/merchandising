{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smart-responsor.merchandising.surface.v1",
  "title": "Merchandising Surface",
  "type": "object",
  "required": ["key", "title", "surfaceType", "sections"],
  "properties": {
    "key": {"type": "string"},
    "title": {"type": "string"},
    "surfaceType": {"type": "string"},
    "summary": {"type": ["string", "null"]},
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["key", "title", "type", "priority", "items"],
      "properties": {
        "key": {"type": "string"},
        "title": {"type": "string"},
        "type": {"type": "string"},
        "priority": {"type": "integer"},
        "items": {
          "type": "array",
          "items": {"$ref": "#/$defs/item"}
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["key", "title", "summary", "kind"],
      "properties": {
        "key": {"type": "string"},
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "kind": {"type": "string"},
        "href": {"type": ["string", "null"]}
      }
    }
  }
}
