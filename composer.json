{
  "name": "merchandising/merch",
  "description": "Merchandising process app",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/serializer": "^8.1",
    "doctrine/orm": "^3.6",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpunit/phpunit": "^12.0",
    "friendsofphp/php-cs-fixer": "^3.65",
    "symfony/phpunit-bridge": "^8.1",
    "symfony/test-pack": "^1.2",
    "symfony/panther": "^2.4",
    "gating/gate": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Merchandising\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Merchandising\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "runtime:about": "php bin/console about",
    "canon:check": "@gate",
    "quality:doctrine:schema": "php bin/console doctrine:schema:validate --skip-sync --no-interaction",
    "quality:doctrine:migrations": "php bin/console doctrine:migrations:up-to-date --no-interaction",
    "quality:doctrine": [
      "@quality:doctrine:schema",
      "@quality:doctrine:migrations"
    ],
    "quality:phpstan": "phpstan analyse --memory-limit=1G",
    "quality:phpunit": "phpunit -c phpunit.xml.dist",
    "quality:phpunit:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit -c phpunit.xml.dist --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "quality:cs:dry": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
    "quality:cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
    "quality:ui": "npm test",
    "test:behavioral-coverage": "@php tool/behavioral-coverage.php",
    "quality": [
      "@quality:phpstan",
      "@quality:phpunit",
      "@quality:cs:dry",
      "@quality:ui",
      "@test:behavioral-coverage",
      "@gate"
    ],
    "quality:po": "@quality",
    "quality:post": "@quality",
    "quality:post-seal-owner-handoff-index": "@quality",
    "quality:rc-owner-review-final-seal": "@quality",
    "gate": "@php vendor/bin/gating check --target=. --profile=config/merch_gating_profile.json"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ]
}
